# ==============================================================================
# PNW Navigator: Environment Configuration Template
# Copy this file to .env and fill in your database credentials:
#   cp .env.example .env
# ==============================================================================

# PostgreSQL Connection String with pgvector support (e.g. Neon Serverless Postgres)
# Format: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.c-2.neon.tech/neondb?sslmode=require"

# Local LLM Serving URL (Default for Ollama on Windows/Linux/macOS)
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Offline embedding model cache flag (prevents external HuggingFace Hub network calls)
TRANSFORMERS_OFFLINE="1"
HF_HUB_OFFLINE="1"
